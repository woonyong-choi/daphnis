flow right
title "Order events fan out"
subtitle "Orders from the web and the app fill an event queue while stock, payment, and notification consumers take them at their own pace. Some notifications are lost"

box web "Web" icon=desktop
box app "App" icon=mobile
box api "Order API" icon=server
queue q "Order events" slots=8
box stock "Stock" icon=db
box pay "Payment" icon=key
box notify "Notify" icon=mobile

value left "Left" on=stock from=120
value paid "Paid" on=pay
value sent "Sent" on=notify
value orders "Orders" on=api
on api orders+1
on q q+1
on stock left-1
on pay paid+1
on notify sent+1

web -> api
app -> api
api -> q
q -> stock
q -> pay
q -> notify

step "Events in flight" "Dots move at different paces, values change as they arrive, and the queue fills" for=14s
  track web -> api -> q at=0s every=1200ms time=1500ms
  track app -> api -> q at=500ms every=2s time=1500ms tone=purple
  track q -> stock "Reserve" at=2500ms every=3s time=1200ms set="q-1@q"
  track q -> pay "Charge" at=3500ms every=4s time=1800ms tone=purple set="q-1@q"
  track q -> notify at=4s every=7s time=1500ms tone=gray set="q-1@q"
  track q -> notify at=6s every=7s time=1500ms tone=red lost=60% set="q-1@q"
