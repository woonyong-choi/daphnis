flow right
title "클라우드 구성도"
subtitle "사용자 요청이 게이트웨이, 로드 밸런서, 웹 서버, 앱 서버를 거쳐 저장소에 닿는 순서(1~7)"

person user "사용자"
group cloud "클라우드" icon=region category="영역" direction=right layout=ordered align=start {
  group edge "퍼블릭" icon=subnet direction=down {
    box igw "게이트웨이" icon=igw category="네트워크" badge="IGW"
    box lb "로드 밸런서" icon=lb category="네트워크" badge="LB"
  }
  group priv "프라이빗" icon=subnet direction=down {
    box web "웹 서버" icon=server category="컴퓨트" badge="WEB"
    box app "앱 서버" icon=server category="컴퓨트" badge="APP"
  }
  group data "데이터" icon=subnet direction=down {
    store db "DB" icon=db category="저장소" badge="DB"
    store files "스토리지" icon=object category="저장소" badge="OBJ"
  }
}

user -> igw no=1 head=end
igw -> lb no=2 head=end
lb -> web no=3 head=end
web -> app no=4 head=end
app -> db no=5 head=end
app -> files no=6 head=end
db -> files no=7 head=end

step "들어오기" "요청이 게이트웨이와 로드 밸런서를 지난다"
  user -> igw
  igw -> lb
step "처리" "웹 서버가 앱 서버를 부른다"
  lb -> web
  web -> app
step "저장" "앱 서버가 데이터베이스와 스토리지를 쓴다"
  app -> db & app -> files
  db -> files
