daphnis 2
title "잠금을 기다리는 작업"
box a "작업 A"
box b "작업 B"
box lock "잠금"
value holder "쥔 쪽" on=lock from=none
a -> lock
b -> lock

scene "A가 잠금을 쥔다" mode=once
  a -> lock "획득" time=1s set="holder=A"

scene "풀리면 B가 들어간다" mode=once keep="holder" status="b=wait"
  a -> lock "해제" time=1s set="holder=none" & b -> lock "획득" time=2s wait="holder='none'" set="holder=B"
