daphnis 2
title "async 작업 하나의 생애주기"
subtitle "정상 완료, I/O 대기 후 재개, 취소, 실패가 같은 상태 위에서 갈라진다"

state created "생성됨"
state queued "대기열"
state running "실행 중"
state awaiting "await 대기"
state done "완료"
state cancelled "취소됨"
state failed "실패"
start created
final done
final cancelled
final failed

created -> queued "`spawn`"
queued -> running "루프가 `poll`"
running -> awaiting "I/O 요청"
awaiting -> running "`wake` 후 다시 `poll`"
running -> done "`return`"
awaiting -> cancelled "`cancel()`" dashed
running -> failed "예외 발생" dashed

view main graph right

scene "정상 완료" mode=once
  created -> queued
  queued -> running
  running -> done
scene "I/O 대기 후 재개" mode=once
  created -> queued
  queued -> running
  running -> awaiting "소켓 읽기"
  wait 1s
  awaiting -> running
  running -> done
scene "취소" mode=once
  queued -> running
  running -> awaiting
  awaiting -> cancelled "타임아웃"
scene "실패" mode=once
  queued -> running
  running -> failed "`ValueError`"
