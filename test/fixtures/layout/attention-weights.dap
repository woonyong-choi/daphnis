daphnis 2

chart weights "어텐션 가중치: the cat sat down" heatmap "예시 데이터. 행은 질의 토큰, 열은 키 토큰이고 각 행의 합은 1이다" {
  cell "the" "the" 0.60
  cell "the" "cat" 0.25
  cell "the" "sat" 0.10
  cell "the" "down" 0.05
  cell "cat" "the" 0.05
  cell "cat" "cat" 0.35
  cell "cat" "sat" 0.50
  cell "cat" "down" 0.10
  cell "sat" "the" 0.05
  cell "sat" "cat" 0.60
  cell "sat" "sat" 0.25
  cell "sat" "down" 0.10
  cell "down" "the" 0.05
  cell "down" "cat" 0.10
  cell "down" "sat" 0.55
  cell "down" "down" 0.30
}

scene "전체 보기" mode=once
  light weights "cat" "the"
scene "cat 행" mode=once
  light weights "cat" "the"
  light weights "cat" "cat"
  light weights "cat" "sat"
  light weights "cat" "down"
