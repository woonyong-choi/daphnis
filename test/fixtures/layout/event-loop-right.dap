daphnis 2
title "이벤트 루프와 스레드 풀"
subtitle "느린 일은 워커로, 기다리는 일은 운영체제로 넘기고 루프는 계속 돈다"

box caller "호출 코드" "`await fetch()`"
group loop "이벤트 루프" direction=down {
  store queue "작업 대기열"
  box runner "실행기" "한 번에 하나씩"
}
group pool "스레드 풀" direction=down {
  box w1 "워커 1"
  box w2 "워커 2"
}
external os "운영체제 I/O" "`epoll`"
store result "결과 채널" "Future"

caller -> queue "작업 제출"
queue -> runner "다음 작업"
runner -> w1 "블로킹 작업"
runner -> w2 "블로킹 작업"
runner -> os "소켓 읽기"
os -> queue "완료 알림" dashed
w1 -> result "결과"
w2 -> result "결과"
result -> caller "값 반환" dashed

view main graph right

scene "작업 제출" mode=once
  caller -> queue "`task A`"
  show queue "A: 파일 해시" tag="대기"
  show queue "B: 이미지 변환" tag="대기"
scene "블로킹 작업을 워커로" mode=once
  queue -> runner
  clear queue
  show queue "B: 이미지 변환" tag="대기"
  runner -> w1 "A: 파일 해시"
  show w1 "A: 파일 해시" tag="실행"
scene "두 워커가 동시에" mode=once
  queue -> runner
  clear queue
  runner -> w2 "B: 이미지 변환" & runner -> os "C: 소켓 읽기"
  show w2 "B: 이미지 변환" tag="실행"
scene "I/O 완료 알림" mode=once
  os -> queue "C 준비됨"
  show queue "C: 읽기 완료" tag="재개"
scene "결과 반환" mode=once
  w1 -> result "A 해시" & w2 -> result "B 이미지"
  show result "A, B 완료" tag="완료"
  result -> caller
  show caller "A, B 결과 수신" tag="완료"
