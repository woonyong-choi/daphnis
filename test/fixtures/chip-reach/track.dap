daphnis 2
title "요청이 두 서비스를 지난다"
subtitle "선 이름 위를 지나는 흐름 점이 글 상자를 달고 다닌다"

person user "사용자"
box gateway "게이트웨이"
box orders "주문 서비스"
store db "주문 DB"
user -> gateway "요청 접수"
gateway -> orders "주문 검증"
orders -> db "저장"

scene "흐름" mode=once for=6s
  track user -> gateway -> orders -> db "주문 요청 하나" time=4s
