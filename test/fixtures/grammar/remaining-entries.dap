daphnis 2
title "문법 표의 남은 항목"
subtitle "다른 원본이 쓰지 않는 낱말과 값을 한 곳에 모은다"

box a "A" shape=rect
box b "B" shape=circle
box c "C"
value n "N" on=a

group solid "실선 그룹" border=solid {
  box d "D"
}

class shape "Shape" {
  field id "UUID" visibility=package
}

trace t "느린 구간" unit=s {
  span all "전체" lane=a at=0 dur=20
  span part "일부" lane=b at=2 dur=6
}

chart c1 "선형 눈금" line {
  x "주"
  y "처리량(건)"
  scale linear
  series a "A"
  point x=1 a=3
  point x=2 a=5
}

a -> b head=end
b -> c
a -> c

scene "대기하다 포기한다" mode=once
  b -> c "요청" time=1s wait="n=1" timeout=2s else=a
