daphnis 2
title "주문 한 건"
subtitle "고객 요청이 API 칸에서 스키마 칸으로 저장되고, 같은 사건이 호출 순서, 지연 그래프, 실제 시간에 함께 보인다"

person user "고객"
box gw "Gateway" icon=server
box pay "Payment" icon=server
api create "POST /orders" {
  body "OrderRequest"
  created "201 Order"
}
table orders "orders" {
  id bigint pk
  status text
}
value depth "대기" on=pay from=0
value p95 "p95(ms)" from=120
chart lag "처리 지연" bar {
  x "처리 시간(ms)"
  series ms "ms"
  row "p50" ms=40
  row "p95" ms=p95
}
chart trend "p95 추이" line {
  y "latency(ms)"
  series p95 "p95"
  point x=1 p95=110
  point x=2 p95=p95
}
trace t "결제 추적" unit=ms {
  span s1 "POST /pay" lane=gw at=0 dur=180
  span s2 "charge" lane=pay at=20 dur=140
}

user -> create.body "요청"
create.body -> orders.id "저장"
user -> gw
gw -> pay

view arch graph right "구조"
view calls sequence "호출 순서" {
  user gw pay
}
view latency plot "지연" {
  trend
}
view timing time "실제 시간" {
  t
}

scene "주문 한 건" mode=loop speed=1.5
  user -> create.body "주문"
  create.body -> orders.id set="depth+1"
  user -> gw "POST /pay"
  gw -> pay "charge" set="p95=150"
  pay -> gw "ok" dashed
  light t.s2
