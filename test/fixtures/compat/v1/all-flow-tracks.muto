flow right
title "흐름과 값"
box web "웹"
box api "API"
store db "DB"
box view "화면"
value stock "재고" on=db from=9
value shown "화면 재고" on=view ref=stock
value state "상태" on=api from=idle
web -> api
api -> db

step "박자" "박자 단계에서도 값이 바뀐다"
  web -> api "요청" tone=purple set="state=busy"
  api -> db "저장" tone=gray set="stock-1, state=idle"

step "흐름" "흐름 단계" for=10s
  track web -> api -> db "주문" at=0s every=3s time=4s tone=teal set="stock-1@db, state=busy@api"
  track web -> api tone=green set="stock=7"
