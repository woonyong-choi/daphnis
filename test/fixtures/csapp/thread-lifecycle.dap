daphnis 2
title "스레드 생애주기"
subtitle "생성, 실행, 대기, 종료와 회수. 합류 가능 스레드는 join으로, 분리된 스레드는 스스로 회수된다"

state created "생성됨"
state running "실행 중"
state blocked "대기 중"
state joinable "종료됨, join 대기"
state detached "분리된 실행 중"
state reaped "회수됨"
final reaped

created -> running "pthread_create 뒤 스케줄"
running -> blocked "P(s) 에서 s가 0"
blocked -> running "다른 스레드의 V(s)"
running -> joinable "return, pthread_exit"
joinable -> reaped "pthread_join 이 자원 회수"
running -> detached "pthread_detach"
detached -> reaped "종료할 때 자원 자동 반납"

view main graph down

scene "합류 가능 스레드" mode=once
  created -> running
  running -> blocked
  blocked -> running
  running -> joinable
  joinable -> reaped
scene "분리된 스레드" mode=once
  created -> running
  running -> detached
  detached -> reaped
