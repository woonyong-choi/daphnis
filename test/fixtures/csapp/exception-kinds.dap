daphnis 2
title "예외의 종류와 복귀 위치"
subtitle "네 종류 모두 예외 번호로 예외 테이블을 찾아 핸들러로 가지만, 돌아가는 곳이 다르다"

group causes "원인" direction=down {
  box irq "인터럽트" "장치 신호, 비동기"
  box trap "트랩" "의도한 예외, 동기"
  box fault "폴트" "복구 가능, 동기"
  box abort "중단" "복구 불가, 동기"
}
box extab "예외 테이블" "번호 k → 핸들러 주소"
box handler "핸들러 k" "커널 모드에서 실행"
group back "복귀 위치" direction=down {
  box next "I_next" "다음 명령"
  box curr "I_curr" "현재 명령 재실행"
  box exit "복귀 안 함" "프로그램 종료"
}

irq -> extab "번호 32"
trap -> extab "번호 128"
fault -> extab "번호 14"
abort -> extab "번호 18"
extab -> handler "주소 k"
handler -> next "인터럽트, 트랩"
handler -> curr "폴트 성공"
handler -> exit "실패, 중단"

scene "인터럽트" mode=once
  irq -> extab "타이머 신호"
  show irq "프로그램과 무관하게 비동기로 옴" tag="비동기"
  extab -> handler "예외 번호 32"
  handler -> next "I_next 실행"
  show next "인터럽트가 없었던 것처럼 이어짐" tag="복귀"
scene "트랩" mode=once
  trap -> extab "syscall"
  show trap "write 시스템 콜 번호 1" tag="동기"
  extab -> handler "예외 번호 128"
  handler -> next "I_next 실행"
  show next "서비스가 끝나면 다음 명령" tag="복귀"
scene "폴트" mode=once
  fault -> extab "페이지 폴트"
  show fault "주소 번역에서 유효 비트 0" tag="동기"
  extab -> handler "예외 번호 14"
  handler -> curr "처리 성공"
  show curr "페이지를 올린 뒤 같은 명령 재실행" tag="재실행"
scene "중단" mode=once
  abort -> extab "머신 체크"
  show abort "DRAM 패리티 오류" tag="동기"
  extab -> handler "예외 번호 18"
  handler -> exit "abort 루틴"
  show exit "프로그램을 종료" tag="종료" tone=gray
