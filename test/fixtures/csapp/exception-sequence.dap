daphnis 2
title "예외가 발생하고 복귀하는 순서"
subtitle "트랩은 다음 명령으로, 폴트는 같은 명령으로 돌아온다"

person app "응용 프로그램"
box cpu "CPU"
store extab "예외 테이블"
box handler "커널 핸들러"

view calls sequence "예외 순서" {
  app cpu extab handler
}

scene "트랩: write 시스템 콜" mode=once
  app -> cpu "syscall (I_curr)"
  cpu -> cpu "복귀 주소 I_next 저장, 커널 모드"
  cpu -> extab "예외 번호 128로 찾기"
  extab -> cpu "핸들러 주소" dashed
  cpu -> handler "핸들러로 점프"
  handler -> handler "write 서비스 수행"
  handler -> cpu "iret 복귀" dashed
  cpu -> app "I_next부터 실행, 사용자 모드" dashed
scene "폴트: 페이지 폴트" mode=once
  app -> cpu "mov (VA 접근, I_curr)"
  cpu -> cpu "복귀 주소 I_curr 저장, 커널 모드"
  cpu -> extab "예외 번호 14로 찾기"
  extab -> cpu "핸들러 주소" dashed
  cpu -> handler "핸들러로 점프"
  handler -> handler "페이지를 DRAM에 올림"
  handler -> cpu "iret 복귀" dashed
  cpu -> app "I_curr부터 다시 실행" dashed
