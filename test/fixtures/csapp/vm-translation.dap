daphnis 2
title "가상 주소 번역 전체 흐름"
subtitle "VA 0x7F3A12345678은 처음엔 TLB 실패, 다시 접근하면 TLB 적중이다. 다단계 조회는 아래 그림에서 자세히 본다"

box cpu "CPU" "load 명령"
box mmu "MMU" "주소 분할"
box tlb "TLB" "64개, 4-way, 16세트"
box walk "페이지 테이블 조회" "4단계, 자세히는 다음 그림"
box cache "L1 d-캐시" "PA로 찾음"
store mem "주 메모리"

cpu -> mmu "VA"
mmu -> tlb "VPN"
tlb -> walk "TLB 실패"
tlb -> cache "적중" dashed
walk -> cache "PPN"
cache -> mem "L1 실패" quiet

scene "TLB 실패" mode=once
  cpu -> mmu "VA 0x7F3A12345678"
  show mmu "VPN 0x7F3A12345" tag="split"
  show mmu "VPO 0x678 (12비트)" tag="split"
  mmu -> tlb "TLBT 0x7F3A1234, TLBI 5"
  show tlb "세트 5에 일치하는 태그 없음" tag="miss" tone=gray
  tlb -> walk "VPN 0x7F3A12345"
  show walk "VPN1 254, VPN2 232, VPN3 145, VPN4 325" tag="walk"
  walk -> cache "PPN 0xA1B2"
  show cache "PA = PPN 0xA1B2 + VPO 0x678" tag="pa" tone=green
  show tlb "세트 5: 태그 0x7F3A1234, PPN 0xA1B2" tag="fill" tone=purple
scene "캐시와 메모리" mode=once
  show cache "PA를 CT, CI, CO로 나눔" tag="PA"
  cache -> mem "블록 요청 PA 0xA1B2678"
  show mem "64바이트 블록을 L1에 돌려줌" tag="fill" tone=purple
scene "다시 접근: TLB 적중" mode=once
  cpu -> mmu "VA 0x7F3A12345679"
  mmu -> tlb "TLBT 0x7F3A1234, TLBI 5"
  show tlb "세트 5 태그 일치, V=1" tag="hit" tone=green
  tlb -> cache "PPN 0xA1B2"
  show cache "PA 0xA1B2679, L1 적중" tag="hit" tone=green
