daphnis 2

chart progress "진행 그래프: 두 스레드의 cnt++ 실행 궤적" heatmap "열은 스레드 1의 명령, 행은 스레드 2의 명령. 1인 칸은 둘 다 임계 영역(L, U, S)에 있는 불안전 영역이다" {
  cell "H2" "H1" 0
  cell "H2" "L1" 0
  cell "H2" "U1" 0
  cell "H2" "S1" 0
  cell "H2" "T1" 0
  cell "L2" "H1" 0
  cell "L2" "L1" 1
  cell "L2" "U1" 1
  cell "L2" "S1" 1
  cell "L2" "T1" 0
  cell "U2" "H1" 0
  cell "U2" "L1" 1
  cell "U2" "U1" 1
  cell "U2" "S1" 1
  cell "U2" "T1" 0
  cell "S2" "H1" 0
  cell "S2" "L1" 1
  cell "S2" "U1" 1
  cell "S2" "S1" 1
  cell "S2" "T1" 0
  cell "T2" "H1" 0
  cell "T2" "L1" 0
  cell "T2" "U1" 0
  cell "T2" "S1" 0
  cell "T2" "T1" 0
}

scene "안전한 궤적" mode=once
  light progress "H2" "H1"
  light progress "H2" "L1"
  light progress "H2" "U1"
  light progress "H2" "S1"
  light progress "H2" "T1"
  light progress "L2" "T1"
  light progress "U2" "T1"
  light progress "S2" "T1"
  light progress "T2" "T1"
scene "불안전한 궤적" mode=once
  light progress "H2" "H1"
  light progress "H2" "L1"
  light progress "L2" "L1"
  light progress "L2" "U1"
  light progress "U2" "U1"
  light progress "U2" "S1"
